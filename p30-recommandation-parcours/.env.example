# Copier ce fichier en ".env" et remplacer les valeurs.
# Le fichier .env est ignoré par Git (voir .gitignore) : ne jamais le publier.

# --- Neo4j (utilisé par docker-compose.yml, init_neo4j.py et le backend) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=remplacer_par_un_mot_de_passe_fort
NEO4J_DATABASE=neo4j

# Ports exposés par Docker (optionnel)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Backend FastAPI ---
# Clé exigée dans l'en-tête X-API-Key pour toute écriture (POST/PUT/DELETE).
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=remplacer_par_une_cle_aleatoire
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:8501

# --- Frontend Streamlit ---
API_URL=http://localhost:8000
